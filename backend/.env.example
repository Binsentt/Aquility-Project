NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://username:password@localhost:5432/aquility
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
UPLOAD_DIR=./uploads
CORS_ORIGIN=*
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL=8h
MEDIA_TOKEN_TTL=5m
GUEST_ARCHIVE_DAYS=30
GUEST_ARCHIVE_INTERVAL_MS=21600000
LOG_REQUESTS=false
