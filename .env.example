# Default for Expo Go, web, and EAS builds:
EXPO_PUBLIC_API_BASE_URL=https://aquality-api-production.up.railway.app/api
# Local/LAN development is opt-in. Set both values explicitly when the local
# backend is intentionally running; otherwise private HTTP URLs are ignored.
EXPO_PUBLIC_ALLOW_LOCAL_API=false
# EXPO_PUBLIC_ALLOW_LOCAL_API=true
# EXPO_PUBLIC_API_BASE_URL=http://<LAPTOP_LAN_IP>:4000/api
